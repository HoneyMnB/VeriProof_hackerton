# 구매자 에이전트 B의 루트 배포 진입점.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080

WORKDIR /app

COPY agents/buyer_agent/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY agents ./agents

EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn agents.buyer_agent.app:application --host 0.0.0.0 --port ${PORT}"]
