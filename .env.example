# 실제 x402 결제 수취가 가능한 Devnet 판매자 공개키.
DEMO_CREATOR_WALLET=

POSTGRES_DB=veriproof
POSTGRES_USER=veriproof
POSTGRES_PASSWORD=veriproof
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

# 결제 후 원본 다운로드 권한 기간. 결제 장부는 보존하고 다운로드 권한만 7일 후 만료한다.
DOWNLOAD_TOKEN_TTL_SECONDS=604800

# ADK는 Vertex AI 인증에 애플리케이션 기본 사용자 인증 정보를 사용한다.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast3
ADK_MODEL=gemini-2.5-flash

# 로컬 Docker 기본값이다. 배포 후에는 Cloud Run HTTPS URL로 변경한다.
A2A_PUBLIC_BASE_URL=http://web:8080
SELLER_AGENT_CARD_URL=http://web:8080/.well-known/agent-card.json
SELLER_API_BASE_URL=http://web:8080
BUYER_AGENT_PUBLIC_BASE_URL=http://localhost:8001
