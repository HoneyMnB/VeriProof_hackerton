DOCKER_NETWORK=google-solana
# Optional. Defaults to <project>/.runtime/media when empty.
MEDIA_HOST_PATH=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_RPC_URL=https://api.devnet.solana.com

# 해커톤 1단계 Buyer Agent 자율 결제 설정.
# 실제 Devnet USDC가 있는 테스트 전용 지갑만 사용하고 운영 지갑은 넣지 않는다.
BUYER_AUTONOMOUS_SOL_PAYMENT_ENABLED=true
BUYER_MAX_PAYMENT_SOL=0.5
# 운영에서는 .../cryptoKeys/.../cryptoKeyVersions/1 형식으로 버전을 명시한다.
BUYER_KMS_KEY_NAME=
BUYER_AUTONOMOUS_SPONSORED_USDC_ENABLED=false
BUYER_MAX_SPONSORED_USDC=0
# Shared only by the Buyer Agent and the VeriProof API deployment. Do not put
# it in browser-delivered settings.
AGENT_SPONSORED_PAYMENT_TOKEN=

# Browser USDC gasless checkout. Keep this sponsor key separate from escrow;
# it holds SOL only for transaction/ATA fees and signs through KMS in production.
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
PAYMENT_SPONSOR_PUBKEY=
PAYMENT_SPONSOR_SECRET_KEY=
PAYMENT_SPONSOR_KMS_KEY_NAME=
SPONSORED_PAYMENT_TTL_SECONDS=300
# Agent-sponsored checkout is bound to a provisioned service user and the
# public key derived from BUYER_KMS_KEY_NAME (or the Devnet fallback key).
AGENT_SPONSORED_PAYMENT_BUYER_USERNAME=
AGENT_SPONSORED_PAYMENT_BUYER_PUBKEY=
# 로컬 Devnet 및 legacy x402용 폴백. 운영 배포는 Secret Manager에서 주입한다.
BUYER_WALLET_SECRET_KEY=




POSTGRES_DB=veriproof
POSTGRES_USER=veriproof
POSTGRES_PASSWORD=veriproof
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

# 결제 후 원본 다운로드 권한 기간. 결제 장부는 보존하고 다운로드 권한만 7일 후 만료한다.
DOWNLOAD_TOKEN_TTL_SECONDS=604800

# ADK는 Vertex AI 인증에 애플리케이션 기본 사용자 인증 정보를 사용한다.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
ADK_MODEL=gemini-3.1-flash-lite

# 로컬 Docker 기본값이다. 배포 후에는 Cloud Run HTTPS URL로 변경한다.
A2A_PUBLIC_BASE_URL=http://web:8080
SELLER_AGENT_CARD_URL=http://web:8080/.well-known/agent-card.json
SELLER_API_BASE_URL=http://web:8080
BUYER_AGENT_PUBLIC_BASE_URL=http://localhost:8001
