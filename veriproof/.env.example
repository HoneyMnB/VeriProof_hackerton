# =============================================================================
# VeriProof AI — environment template (architecture 1.4).
# Copy to .env and adjust. The DEFAULT values below are the LOCAL-FALLBACK
# state: the app boots with no real external keys and the full pytest suite
# runs offline. Flip flags ON for cloud deployment.
# =============================================================================

# --- App / Django ---
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
VERIPROOF_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# A URL-safe base64 Fernet key. Required when DJANGO_DEBUG=false; manage it in Secret Manager.
WALLET_PRIVATE_KEY_ENCRYPTION_KEY=

# Buyer agent의 SOL 자율 결제 활성화 및 건당 한도
BUYER_AUTONOMOUS_SOL_PAYMENT_ENABLED=true
BUYER_MAX_PAYMENT_SOL=0.5
# Solana Devnet RPC
SOLANA_RPC_URL=https://api.devnet.solana.com
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
BUYER_WALLET_SECRET_KEY=
BUYER_KMS_KEY_NAME=


# --- Database ---
# Default: local SQLite (zero-infra TDD). Set DATABASE_URL for PostgreSQL.
# DATABASE_URL=postgres://user:pass@localhost:5432/veriproof

# --- AI (Gemini / Vertex) ---
GEMINI_API_KEYS=
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_BATCH_MODEL=gemini-3.5-flash-lite
VERTEX_ENABLED=false
VERTEX_PROJECT=
VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# --- A2A / ADK ---
# Cloud Run 주소 예시: https://<django-service>-<hash>.<region>.run.app
A2A_PUBLIC_BASE_URL=http://localhost:8000
ADK_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast3

# --- Solana / payments ---
SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
PLATFORM_ESCROW_PUBKEY=
# 로컬 Devnet 전용 폴백. 운영에서는 KMS_KEY_NAME을 사용한다.
PLATFORM_ESCROW_SECRET_KEY=
# projects/.../locations/.../keyRings/.../cryptoKeys/... 또는 key version
KMS_KEY_NAME=
PAYSH_WEBHOOK_SECRET=
AP2_ENABLED=false

# --- GCP pipeline / data (all degrade to no-op when disabled) ---
GCP_PROJECT_ID=
PUBSUB_PAYMENTS_TOPIC=veriproof-payments
FIRESTORE_ENABLED=false
FIRESTORE_DATABASE=(default)
BIGQUERY_DATASET=
STORAGE_BACKEND=local
GCS_BUCKET=

# --- App tunable constants (architecture 1.4) ---
ORIGINAL_RETENTION_DAYS=7
DOWNLOAD_TOKEN_TTL_SECONDS=604800
MAX_UPLOAD_BYTES=10485760
MAX_WORK_IMAGES=10
MAX_NEGOTIATION_ROUNDS=5
MICRO_FLOOR_USDC=0.05
BATCH_MAX_ITEMS=200
SANDBOX_MODE=mock
